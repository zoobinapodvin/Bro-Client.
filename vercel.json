{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/offres",
      "destination": "/offres.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/platform?route=api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/platform?route=auth/:path*"
    },
    {
      "source": "/checkout/:plan",
      "destination": "/api/platform?route=checkout/:plan"
    },
    {
      "source": "/media/:id",
      "destination": "/api/platform?route=media/:id"
    }
  ],
  "crons": [
    {
      "path": "/api/discord/cron",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self' data:; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
